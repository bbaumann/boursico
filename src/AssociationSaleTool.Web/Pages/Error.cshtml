@page "/erreur"
@model ErrorModel
@{
    ViewData["Title"] = "Erreur";
}

<section class="page-card form-card">
    <p class="eyebrow">Erreur</p>
    <h1 class="page-title">Une erreur s'est produite.</h1>
    <p class="lead">La demande n'a pas pu être traitée correctement.</p>

    @if (Model.ShowRequestId)
    {
        <p><strong>Identifiant de requête :</strong> <code>@Model.RequestId</code></p>
    }
}</section>

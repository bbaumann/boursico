@page "{id:long}"
@model AssociationSaleTool.Web.Pages.Items.EditModel
@{
    ViewData["Title"] = "Edit Item";
}

<section class="page-card form-card">
    <p class="eyebrow">Intake</p>
    <h1 class="page-title">Edit Item</h1>
    <p class="seller-meta">@Model.Item!.Reference</p>

    <form method="post" class="stack-form">
        <label>
            <span>Title</span>
            <input asp-for="Input.Title" />
            <span asp-validation-for="Input.Title" class="validation"></span>
        </label>

        <label>
            <span>Seller price (cents)</span>
            <input asp-for="Input.SellerPriceCents" />
            <span asp-validation-for="Input.SellerPriceCents" class="validation"></span>
        </label>

        <div class="form-actions">
            <button type="submit" class="button-link button-link-solid">Save Item</button>
            <a class="button-link" asp-page="/Sellers/Details" asp-route-id="@Model.Item.SellerId">Cancel</a>
        </div>
    </form>
</section>

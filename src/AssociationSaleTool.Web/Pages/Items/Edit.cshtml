@page "/articles/{id:long}/modifier"
@model AssociationSaleTool.Web.Pages.Items.EditModel
@{
    ViewData["Title"] = "Modifier l'article";
}

<section class="page-card form-card">
    <p class="eyebrow">Saisie</p>
    <h1 class="page-title">Modifier l'article</h1>
    <p class="seller-meta">@Model.Item!.Reference</p>

    @if (!Model.CanEditItem)
    {
        <p class="validation">Cet article ne peut pas être modifié dans le statut actuel de la vente.</p>
    }
    else
    {
    <form method="post" class="stack-form">
        <div asp-validation-summary="ModelOnly" class="validation"></div>
        <label>
            <span>Titre</span>
            <input asp-for="Input.Title" />
            <span asp-validation-for="Input.Title" class="validation"></span>
        </label>

        <label>
            <span>Prix vendeur (EUR entier)</span>
            <input asp-for="Input.SellerPrice" type="number" min="0" step="1" inputmode="numeric" />
            <span asp-validation-for="Input.SellerPrice" class="validation"></span>
        </label>

        <div class="form-actions">
            <button type="submit" class="button-link button-link-solid">Enregistrer l'article</button>
            <a class="button-link" asp-page="/Sellers/Details" asp-route-id="@Model.Item.SellerId">Annuler</a>
        </div>
    </form>
    }
</section>

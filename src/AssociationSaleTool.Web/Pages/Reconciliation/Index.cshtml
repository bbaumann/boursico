@page "/rapprochement"
@using AssociationSaleTool.Web.Infrastructure
@model AssociationSaleTool.Web.Pages.Reconciliation.IndexModel
@{
    ViewData["Title"] = "Rapprochement";
}

@if (!Model.IsUnlocked)
{
    <section class="page-card">
        <div class="page-header">
            <div>
                <p class="eyebrow">Administration</p>
                <h1 class="page-title">Rapprochement</h1>
            </div>
        </div>

        <form method="post" asp-page-handler="Unlock">
            <div asp-validation-summary="ModelOnly" class="validation"></div>
            <label asp-for="PasswordInput.Password">Mot de passe administrateur</label>
            <input asp-for="PasswordInput.Password" type="password" autocomplete="current-password" />
            <span asp-validation-for="PasswordInput.Password" class="validation"></span>

            <div class="form-actions">
                <button type="submit" class="button-link button-link-solid">Déverrouiller</button>
            </div>
        </form>
    </section>
}
else
{
    <section class="page-card">
        <div class="page-header">
            <div>
                <p class="eyebrow">Administration</p>
                <h1 class="page-title">Rapprochement</h1>
            </div>
        </div>

        @if (!Model.CanOperate)
        {
            <p class="validation">Le rapprochement est en lecture seule tant que la vente n'est pas en après-vente.</p>
        }

        @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
        {
            <p class="success-message" role="status">@Model.SuccessMessage</p>

            @if (Model.CanOperate && !string.IsNullOrWhiteSpace(Model.CorrectedSellerCode))
            {
                <p>
                    <a href="/rapprochement/feuilles?codeVendeur=@Model.CorrectedSellerCode">
                        Imprimer la feuille du vendeur @Model.CorrectedSellerCode
                    </a>
                </p>
            }
        }

        <div asp-validation-summary="ModelOnly" class="validation"></div>

        <section class="subsection">
            <div class="page-header">
                <div>
                    <h2>Feuilles vendeurs</h2>
                </div>
                @if (Model.CanOperate)
                {
                    <a class="button-link button-link-solid" href="/rapprochement/feuilles">Imprimer toutes les feuilles</a>
                }
            </div>

            @if (Model.CanOperate)
            {
                <form method="get" action="/rapprochement/feuilles">
                    <label asp-for="SheetInput.SellerCode">Code ou nom du vendeur</label>
                    <input name="codeVendeur"
                           id="SheetInput_SellerCode"
                           value="@Model.SheetInput.SellerCode"
                           list="seller-sheet-options"
                           autocomplete="off" />
                    <datalist id="seller-sheet-options">
                        @foreach (var seller in Model.SellerSheetOptions)
                        {
                            <option value="@($"{seller.SellerCode} - {seller.SellerName}")"></option>
                        }
                    </datalist>

                    <div class="form-actions">
                        <button type="submit" class="button-link">Imprimer une feuille</button>
                    </div>
                </form>
            }
            else
            {
                <p class="empty-state">Les feuilles vendeurs seront disponibles en après-vente.</p>
            }
        </section>

        <section class="subsection" data-reconciliation-root>
            <h2>Correction des articles</h2>

            <label for="reconciliation-search">Filtrer les articles</label>
            <input id="reconciliation-search"
                   type="search"
                   autocomplete="off"
                   data-reconciliation-search />
            <p class="empty-state" data-reconciliation-empty-message hidden>Aucun article ne correspond à cette recherche.</p>

            @if (Model.CorrectionItems.Count > 0)
            {
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>REF</th>
                            <th>Description</th>
                            <th>Vendeur</th>
                            <th>Statut</th>
                            <th>Prix</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody data-reconciliation-results>
                    @foreach (var item in Model.CorrectionItems)
                    {
                        <tr data-reconciliation-item-row
                            data-reconciliation-filter-text="@IndexModel.BuildCorrectionFilterText(item)">
                            <td>@item.Reference</td>
                            <td>@item.Title</td>
                            <td>@item.SellerCode - @item.SellerName</td>
                            <td>@ItemStatusDisplay.ToFrenchLabel(item.Status)</td>
                            <td>@IndexModel.FormatPrice(item.SellerPriceCents)</td>
                            <td>
                                @if (Model.CanOperate && item.Status == "in_stock")
                                {
                                    <form method="post"
                                          asp-page-handler="MarkMissing"
                                          asp-route-itemId="@item.ItemId"
                                          asp-route-sellerCode="@item.SellerCode">
                                        <button type="submit" class="button-link">Marquer manquant</button>
                                    </form>
                                }

                                @if (Model.CanOperate && item.Status == "missing")
                                {
                                    <form method="post"
                                          asp-page-handler="MarkInStock"
                                          asp-route-itemId="@item.ItemId"
                                          asp-route-sellerCode="@item.SellerCode">
                                        <button type="submit" class="button-link">Remettre en stock</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
            else
            {
                <p class="empty-state">Aucun article à corriger.</p>
            }
        </section>
    </section>
}

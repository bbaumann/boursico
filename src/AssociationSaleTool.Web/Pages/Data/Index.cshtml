@page "/donnees"
@model AssociationSaleTool.Web.Pages.Data.IndexModel
@using AssociationSaleTool.Web.Domain.Sellers
@{
    ViewData["Title"] = "Données";
}

<section class="page-card data-list-page" data-data-list-root>
    <div class="page-header">
        <div>
            <p class="eyebrow">Consultation</p>
            <h1 class="page-title">Donn&eacute;es</h1>
            <p class="seller-meta">Consultation en lecture seule des donn&eacute;es de l'&eacute;v&eacute;nement.</p>
        </div>
    </div>

    <nav class="data-list-tabs" aria-label="Listes de donn&eacute;es">
        <a class="@Model.TabClass("articles")"
           href="/donnees?onglet=articles"
           aria-current="@Model.TabAriaCurrent("articles")">Articles</a>
        <a class="@Model.TabClass("vendeurs")"
           href="/donnees?onglet=vendeurs"
           aria-current="@Model.TabAriaCurrent("vendeurs")">Vendeurs</a>
        <a class="@Model.TabClass("ventes")"
           href="/donnees?onglet=ventes"
           aria-current="@Model.TabAriaCurrent("ventes")">Ventes</a>
        <a class="@Model.TabClass("cheques")"
           href="/donnees?onglet=cheques"
           aria-current="@Model.TabAriaCurrent("cheques")">Ch&egrave;ques</a>
        <a class="@Model.TabClass("cloture")"
           href="/donnees?onglet=cloture"
           aria-current="@Model.TabAriaCurrent("cloture")">Cl&ocirc;ture</a>
        <a class="@Model.TabClass("statistiques")"
           href="/donnees?onglet=statistiques"
           aria-current="@Model.TabAriaCurrent("statistiques")">Statistiques</a>
    </nav>

    @if (Model.IsActiveTab("articles"))
    {
        <section class="subsection">
            <div class="data-list-filter-bar">
                <div class="data-list-filter-field data-list-filter-field-search">
                    <label for="data-list-search">Filtrer les articles</label>
                    <input id="data-list-search"
                           type="search"
                           autocomplete="off"
                           data-data-list-search
                           placeholder="R&eacute;f&eacute;rence, description, vendeur ou statut" />
                </div>
                <div class="data-list-filter-field data-list-filter-field-status">
                    <label for="data-list-status-filter">Statut</label>
                    <select id="data-list-status-filter" data-data-list-status-filter>
                        <option value="">Tous les statuts</option>
                        <option value="registered">Enregistr&eacute;</option>
                        <option value="in_stock">En stock</option>
                        <option value="sold">Vendu</option>
                        <option value="missing">Manquant</option>
                        <option value="defective">D&eacute;fectueux</option>
                    </select>
                </div>
            </div>
            <p class="empty-state" data-data-list-empty-message hidden>Aucun article ne correspond &agrave; cette recherche.</p>

            @if (Model.Items.Count == 0)
            {
                <p class="empty-state">Aucun article enregistr&eacute;.</p>
            }
            else
            {
                <div class="data-list-scroll">
                <table class="data-table data-list-table" data-data-list-table>
                    <thead>
                        <tr>
                            <th aria-sort="none"><button type="button" class="data-list-sort-button" data-data-list-sort data-data-list-sort-type="text" aria-label="Trier par REF">REF<span class="data-list-sort-indicator" aria-hidden="true"></span></button></th>
                            <th aria-sort="none"><button type="button" class="data-list-sort-button" data-data-list-sort data-data-list-sort-type="text" aria-label="Trier par article">Article<span class="data-list-sort-indicator" aria-hidden="true"></span></button></th>
                            <th aria-sort="none"><button type="button" class="data-list-sort-button" data-data-list-sort data-data-list-sort-type="text" aria-label="Trier par vendeur">Vendeur<span class="data-list-sort-indicator" aria-hidden="true"></span></button></th>
                            <th aria-sort="none"><button type="button" class="data-list-sort-button" data-data-list-sort data-data-list-sort-type="text" aria-label="Trier par statut">Statut<span class="data-list-sort-indicator" aria-hidden="true"></span></button></th>
                            <th aria-sort="none"><button type="button" class="data-list-sort-button" data-data-list-sort data-data-list-sort-type="number" aria-label="Trier par prix">Prix<span class="data-list-sort-indicator" aria-hidden="true"></span></button></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr data-data-list-row
                            data-data-list-filter-text="@item.SearchText"
                            data-data-list-status="@item.Status">
                            <td data-data-list-sort-value="@item.Reference"><a href="/vendeurs/@item.SellerId">@(string.IsNullOrEmpty(item.Reference) ? "—" : item.Reference)</a></td>
                            <td data-data-list-sort-value="@item.Title">@item.Title</td>
                            <td data-data-list-sort-value="@item.SellerCode @item.SellerName">@item.SellerCode - @item.SellerName</td>
                            <td data-data-list-sort-value="@item.StatusLabel">@item.StatusLabel</td>
                            <td data-data-list-sort-value="@item.SellerPriceCents">@IndexModel.FormatPrice(item.SellerPriceCents)</td>
                        </tr>
                    }
                    </tbody>
                </table>
                </div>
            }
        </section>
    }

    @if (Model.IsActiveTab("vendeurs"))
    {
        <section class="subsection">
            <div class="data-list-filter-bar data-list-filter-bar-single">
                <div class="data-list-filter-field data-list-filter-field-search">
                    <label for="data-list-search">Filtrer les vendeurs</label>
                    <input id="data-list-search"
                           type="search"
                           autocomplete="off"
                           data-data-list-search
                           placeholder="Code ou nom" />
                </div>
            </div>
            <p class="empty-state" data-data-list-empty-message hidden>Aucun vendeur ne correspond &agrave; cette recherche.</p>

            @if (Model.Sellers.Count == 0)
            {
                <p class="empty-state">Aucun vendeur enregistr&eacute;.</p>
            }
            else
            {
                <div class="data-list-scroll">
                <table class="data-table data-list-table data-list-seller-table" data-data-list-table>
                    <thead>
                        <tr>
                            <th class="data-list-size-xxs data-list-code-column" aria-sort="none"><button type="button" class="data-list-sort-button" data-data-list-sort data-data-list-sort-type="text" aria-label="Trier par code">Code<span class="data-list-sort-indicator" aria-hidden="true"></span></button></th>
                            <th class="data-list-size-l data-list-name-column" aria-sort="none"><button type="button" class="data-list-sort-button" data-data-list-sort data-data-list-sort-type="text" aria-label="Trier par nom">Nom<span class="data-list-sort-indicator" aria-hidden="true"></span></button></th>
                            <th class="data-list-size-l data-list-email-column" aria-sort="none"><button type="button" class="data-list-sort-button" data-data-list-sort data-data-list-sort-type="text" aria-label="Trier par e-mail">E-mail<span class="data-list-sort-indicator" aria-hidden="true"></span></button></th>
                            <th class="data-list-size-m data-list-phone-column" aria-sort="none"><button type="button" class="data-list-sort-button" data-data-list-sort data-data-list-sort-type="text" aria-label="Trier par t&eacute;l&eacute;phone">T&eacute;l&eacute;phone<span class="data-list-sort-indicator" aria-hidden="true"></span></button></th>
                            <th class="data-list-size-xs data-list-count-column" aria-sort="none"><button type="button" class="data-list-sort-button" data-data-list-sort data-data-list-sort-type="number" aria-label="Trier par total des articles"><abbr title="Total des articles">Tot.</abbr><span class="data-list-sort-indicator" aria-hidden="true"></span></button></th>
                            <th class="data-list-size-xs data-list-count-column" aria-sort="none"><button type="button" class="data-list-sort-button" data-data-list-sort data-data-list-sort-type="number" aria-label="Trier par enregistr&eacute;s"><abbr title="Enregistr&eacute;s">Enr.</abbr><span class="data-list-sort-indicator" aria-hidden="true"></span></button></th>
                            <th class="data-list-size-xs data-list-count-column" aria-sort="none"><button type="button" class="data-list-sort-button" data-data-list-sort data-data-list-sort-type="number" aria-label="Trier par en stock"><abbr title="En stock">Stock</abbr><span class="data-list-sort-indicator" aria-hidden="true"></span></button></th>
                            <th class="data-list-size-xs data-list-count-column" aria-sort="none"><button type="button" class="data-list-sort-button" data-data-list-sort data-data-list-sort-type="number" aria-label="Trier par vendus"><abbr title="Vendus">Vend.</abbr><span class="data-list-sort-indicator" aria-hidden="true"></span></button></th>
                            <th class="data-list-size-xs data-list-count-column" aria-sort="none"><button type="button" class="data-list-sort-button" data-data-list-sort data-data-list-sort-type="number" aria-label="Trier par manquants"><abbr title="Manquants">Manq.</abbr><span class="data-list-sort-indicator" aria-hidden="true"></span></button></th>
                            <th class="data-list-size-xs data-list-count-column data-list-defective-count-column" aria-sort="none"><button type="button" class="data-list-sort-button" data-data-list-sort data-data-list-sort-type="number" aria-label="Trier par d&eacute;fectueux"><abbr title="D&eacute;fectueux">D&eacute;f.</abbr><span class="data-list-sort-indicator" aria-hidden="true"></span></button></th>
                            <th class="data-list-size-xs data-list-fee-column" aria-sort="none"><button type="button" class="data-list-sort-button" data-data-list-sort data-data-list-sort-type="number" aria-label="Trier par frais">Frais<span class="data-list-sort-indicator" aria-hidden="true"></span></button></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var seller in Model.Sellers)
                    {
                        <tr data-data-list-row data-data-list-filter-text="@seller.SearchText">
                            <td class="data-list-size-xxs data-list-code-column" data-data-list-sort-value="@seller.SellerCode"><a href="/vendeurs/@seller.SellerId">@seller.SellerCode</a></td>
                            <td class="data-list-size-l data-list-name-column" data-data-list-sort-value="@seller.SellerName">@seller.SellerName</td>
                            <td class="data-list-size-l data-list-email-column" data-data-list-sort-value="@(seller.Email ?? string.Empty)">@(seller.Email ?? "-")</td>
                            <td class="data-list-size-m data-list-phone-column" data-data-list-sort-value="@seller.Phone">@seller.Phone</td>
                            <td class="data-list-size-xs data-list-count-column" data-data-list-sort-value="@seller.ItemCount">@seller.ItemCount</td>
                            <td class="data-list-size-xs data-list-count-column" data-data-list-sort-value="@seller.RegisteredCount">@seller.RegisteredCount</td>
                            <td class="data-list-size-xs data-list-count-column" data-data-list-sort-value="@seller.InStockCount">@seller.InStockCount</td>
                            <td class="data-list-size-xs data-list-count-column" data-data-list-sort-value="@seller.SoldCount">@seller.SoldCount</td>
                            <td class="data-list-size-xs data-list-count-column" data-data-list-sort-value="@seller.MissingCount">@seller.MissingCount</td>
                            <td class="data-list-size-xs data-list-count-column data-list-defective-count-column" data-data-list-sort-value="@seller.DefectiveCount">@seller.DefectiveCount</td>
                            <td class="data-list-size-xs data-list-fee-column" data-data-list-sort-value="@seller.ExpectedFeeCents">@IndexModel.FormatSellerFeeProgress(seller.PaidFeeCents, seller.ExpectedFeeCents)</td>
                        </tr>
                    }
                    </tbody>
                </table>
                </div>
            }
        </section>
    }

    @if (Model.IsActiveTab("ventes"))
    {
        <section class="subsection">
            <div class="data-list-filter-bar data-list-filter-bar-single">
                <div class="data-list-filter-field data-list-filter-field-search">
                    <label for="data-list-search">Filtrer les ventes</label>
                    <input id="data-list-search"
                           type="search"
                           autocomplete="off"
                           data-data-list-search
                           placeholder="Num&eacute;ro, acheteur, paiement, r&eacute;f&eacute;rence ou description" />
                </div>
            </div>
            <p class="empty-state" data-data-list-empty-message hidden>Aucune vente ne correspond &agrave; cette recherche.</p>

            @if (Model.Sales.Count == 0)
            {
                <p class="empty-state">Aucune vente enregistr&eacute;e.</p>
            }
            else
            {
                <div class="data-list-scroll">
                <table class="data-table data-list-table data-list-sale-table" data-data-list-table>
                    <thead>
                        <tr>
                            <th class="data-list-size-xxs data-list-sale-id-column" aria-sort="none"><button type="button" class="data-list-sort-button" data-data-list-sort data-data-list-sort-type="number" aria-label="Trier par vente">Vente<span class="data-list-sort-indicator" aria-hidden="true"></span></button></th>
                            <th class="data-list-size-m data-list-sale-date-column" aria-sort="none"><button type="button" class="data-list-sort-button" data-data-list-sort data-data-list-sort-type="number" aria-label="Trier par date">Date<span class="data-list-sort-indicator" aria-hidden="true"></span></button></th>
                            <th class="data-list-size-l data-list-sale-buyer-column" aria-sort="none"><button type="button" class="data-list-sort-button" data-data-list-sort data-data-list-sort-type="text" aria-label="Trier par acheteur">Acheteur<span class="data-list-sort-indicator" aria-hidden="true"></span></button></th>
                            <th class="data-list-size-s data-list-sale-money-column" aria-sort="none"><button type="button" class="data-list-sort-button" data-data-list-sort data-data-list-sort-type="number" aria-label="Trier par sous-total">Sous-total<span class="data-list-sort-indicator" aria-hidden="true"></span></button></th>
                            <th class="data-list-size-s data-list-sale-money-column" aria-sort="none"><button type="button" class="data-list-sort-button" data-data-list-sort data-data-list-sort-type="number" aria-label="Trier par total">Total<span class="data-list-sort-indicator" aria-hidden="true"></span></button></th>
                            <th class="data-list-size-s data-list-sale-payment-column" aria-sort="none"><button type="button" class="data-list-sort-button" data-data-list-sort data-data-list-sort-type="text" aria-label="Trier par paiement">Paiement<span class="data-list-sort-indicator" aria-hidden="true"></span></button></th>
                            <th class="data-list-size-xs data-list-sale-invoice-column" aria-sort="none"><button type="button" class="data-list-sort-button" data-data-list-sort data-data-list-sort-type="number" aria-label="Trier par facture">Facture<span class="data-list-sort-indicator" aria-hidden="true"></span></button></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var sale in Model.Sales)
                    {
                        <tr data-data-list-row data-data-list-filter-text="@sale.SearchText">
                            <td class="data-list-size-xxs data-list-sale-id-column" data-data-list-sort-value="@sale.SaleId"><a href="/caisse/ventes/@sale.SaleId">#@sale.SaleId</a></td>
                            <td class="data-list-size-m data-list-sale-date-column" data-data-list-sort-value="@sale.SoldAt.Ticks">@IndexModel.FormatSoldAt(sale.SoldAt)</td>
                            <td class="data-list-size-l data-list-sale-buyer-column" data-data-list-sort-value="@(string.IsNullOrWhiteSpace(sale.BuyerDisplay) ? string.Empty : sale.BuyerDisplay)">@(string.IsNullOrWhiteSpace(sale.BuyerDisplay) ? "-" : sale.BuyerDisplay)</td>
                            <td class="data-list-size-s data-list-sale-money-column" data-data-list-sort-value="@sale.SubtotalSellerPriceCents">@IndexModel.FormatPrice(sale.SubtotalSellerPriceCents)</td>
                            <td class="data-list-size-s data-list-sale-money-column" data-data-list-sort-value="@sale.TotalPaidCents">@IndexModel.FormatPrice(sale.TotalPaidCents)</td>
                            <td class="data-list-size-s data-list-sale-payment-column" data-data-list-sort-value="@sale.PaymentMethodLabel">@sale.PaymentMethodLabel</td>
                            <td class="data-list-size-xs data-list-sale-invoice-column" data-data-list-sort-value="@(sale.HasInvoice ? 1 : 0)">@(sale.HasInvoice ? "Oui" : "Non")</td>
                        </tr>
                    }
                    </tbody>
                </table>
                </div>
            }
        </section>
    }

    @if (Model.IsActiveTab("cheques"))
    {
        <section class="subsection">
            <div class="data-list-filter-bar data-list-filter-bar-single">
                <div class="data-list-filter-field data-list-filter-field-search">
                    <label for="data-list-search">Filtrer les ch&egrave;ques</label>
                    <input id="data-list-search"
                           type="search"
                           autocomplete="off"
                           data-data-list-search
                           placeholder="Vente, num&eacute;ro, banque ou montant" />
                </div>
            </div>
            <p class="empty-state" data-data-list-empty-message hidden>Aucun ch&egrave;que ne correspond &agrave; cette recherche.</p>

            @if (Model.Cheques.Count == 0)
            {
                <p class="empty-state">Aucun ch&egrave;que enregistr&eacute;.</p>
            }
            else
            {
                <div class="data-list-scroll">
                <table class="data-table data-list-table data-list-cheque-table" data-data-list-table>
                    <thead>
                        <tr>
                            <th class="data-list-size-xxs data-list-cheque-sale-column" aria-sort="none"><button type="button" class="data-list-sort-button" data-data-list-sort data-data-list-sort-type="number" aria-label="Trier par vente">Vente<span class="data-list-sort-indicator" aria-hidden="true"></span></button></th>
                            <th aria-sort="none"><button type="button" class="data-list-sort-button" data-data-list-sort data-data-list-sort-type="text" aria-label="Trier par num&eacute;ro de ch&egrave;que">N&deg; ch&egrave;que<span class="data-list-sort-indicator" aria-hidden="true"></span></button></th>
                            <th aria-sort="none"><button type="button" class="data-list-sort-button" data-data-list-sort data-data-list-sort-type="text" aria-label="Trier par banque">Banque<span class="data-list-sort-indicator" aria-hidden="true"></span></button></th>
                            <th aria-sort="none"><button type="button" class="data-list-sort-button" data-data-list-sort data-data-list-sort-type="number" aria-label="Trier par montant">Montant<span class="data-list-sort-indicator" aria-hidden="true"></span></button></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var cheque in Model.Cheques)
                    {
                        <tr data-data-list-row data-data-list-filter-text="@cheque.SearchText">
                            <td class="data-list-size-xxs data-list-cheque-sale-column" data-data-list-sort-value="@cheque.SaleId"><a href="/caisse/ventes/@cheque.SaleId">#@cheque.SaleId</a></td>
                            <td class="data-list-cheque-number-column" data-data-list-sort-value="@cheque.ChequeNumber">@cheque.ChequeNumber</td>
                            <td class="data-list-cheque-bank-column" data-data-list-sort-value="@cheque.ChequeBankName">@cheque.ChequeBankName</td>
                            <td class="data-list-cheque-amount-column" data-data-list-sort-value="@cheque.TotalPaidCents">@IndexModel.FormatPrice(cheque.TotalPaidCents)</td>
                        </tr>
                    }
                    </tbody>
                </table>
                </div>
            }
        </section>
    }

    @if (Model.IsActiveTab("cloture"))
    {
        <section class="subsection">
            @if (Model.ClosingRows.Count == 0)
            {
                <p class="empty-state">Aucune vente enregistr&eacute;e.</p>
            }
            else
            {
                <div class="data-list-scroll">
                <table class="data-table data-list-table data-list-closing-table" data-list-closing-table>
                    <thead>
                        <tr>
                            <th>Caisse</th>
                            <th>Esp&egrave;ces attendues</th>
                            <th>Ch&egrave;ques attendus</th>
                            <th class="data-list-closing-split">CB attendue</th>
                            <th>Ventes</th>
                            <th>Fond</th>
                            <th>Esp&egrave;ces</th>
                            <th>Rembours&eacute;</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model.ClosingRows)
                    {
                        <tr class="@(row.IsGlobal ? "data-list-closing-global-row" : null)">
                            <td>@row.Label</td>
                            <td>@IndexModel.FormatCompactPrice(row.ExpectedCashCents)</td>
                            <td>@IndexModel.FormatCompactPrice(row.ChequeTotalCents)</td>
                            <td class="data-list-closing-split">@IndexModel.FormatCompactPrice(row.CardTotalCents)</td>
                            <td>@row.SaleCount</td>
                            <td>@IndexModel.FormatCompactPrice(row.InitialCashCents)</td>
                            <td>@IndexModel.FormatCompactPrice(row.CashTotalCents)</td>
                            <td>@IndexModel.FormatCompactPrice(row.RefundTotalCents)</td>
                        </tr>
                    }
                    </tbody>
                </table>
                </div>
            }
        </section>
    }

    @if (Model.IsActiveTab("statistiques"))
    {
        @if (Model.StatisticsErrorMessage is not null)
        {
            <p class="validation">@Model.StatisticsErrorMessage</p>
        }
        else if (Model.Statistics is { } statistics)
        {
            var fees = statistics.Fees;
            var clients = statistics.Clients;
            var sellers = statistics.Sellers;
            var items = statistics.Items;

            <section class="subsection">
                <h2>Recettes de l'association</h2>
                <div class="data-list-scroll">
                <table class="data-table statistics-table">
                    <tbody>
                        <tr>
                            <td>Frais d'inscription (@(SellerFeeCalculator.FeePerBlockCents / 100) € par tranche de @SellerFeeCalculator.ItemsPerFeeBlock articles), payés au dépôt</td>
                            <td>@IndexModel.FormatPrice(fees.FlatFeePaidAtDepositCents)</td>
                        </tr>
                        <tr>
                            <td>Frais d'inscription déduits du paiement des vendeurs</td>
                            <td>@IndexModel.FormatPrice(fees.FlatFeeDeductedAtPayoutCents)</td>
                        </tr>
                        <tr>
                            <td>Commission vendeur (@SellerPayoutCalculator.AssociationMarginPercent %), articles vendus et manquants</td>
                            <td>@IndexModel.FormatPrice(fees.SellerMarginCents)</td>
                        </tr>
                        <tr>
                            <td>Frais client (10 %), remboursements déduits</td>
                            <td>@IndexModel.FormatPrice(fees.ClientFeeCents)</td>
                        </tr>
                        <tr class="statistics-total-row">
                            <td>Total</td>
                            <td>@IndexModel.FormatPrice(fees.TotalCents)</td>
                        </tr>
                    </tbody>
                </table>
                </div>
                <p class="seller-meta">
                    Frais d'inscription attendus : @IndexModel.FormatPrice(fees.FlatFeeExpectedCents).
                    @if (fees.FlatFeeUncollectedCents > 0)
                    {
                        <text>Non récupérés : @IndexModel.FormatPrice(fees.FlatFeeUncollectedCents), le paiement de certains vendeurs ne suffisant pas à les couvrir.</text>
                    }
                </p>
            </section>

            <section class="subsection">
                <h2>Argent des clients</h2>
                <div class="data-list-scroll">
                <table class="data-table statistics-table">
                    <tbody>
                        <tr><td>Ventes</td><td>@clients.SaleCount</td></tr>
                        <tr><td>Encaissé</td><td>@IndexModel.FormatPrice(clients.CollectedCents)</td></tr>
                        <tr><td>dont CB</td><td>@IndexModel.FormatPrice(clients.CardCents)</td></tr>
                        <tr><td>dont espèces</td><td>@IndexModel.FormatPrice(clients.CashCents)</td></tr>
                        <tr><td>dont chèques</td><td>@IndexModel.FormatPrice(clients.ChequeCents)</td></tr>
                        <tr><td>Remboursé</td><td>@IndexModel.FormatPrice(clients.RefundedCents)</td></tr>
                        <tr class="statistics-total-row"><td>Net</td><td>@IndexModel.FormatPrice(clients.NetCents)</td></tr>
                    </tbody>
                </table>
                </div>
            </section>

            <section class="subsection">
                <h2>Ventes des vendeurs</h2>
                <div class="data-list-scroll">
                <table class="data-table statistics-table">
                    <tbody>
                        <tr class="statistics-total-row"><td>Prix des articles vendus</td><td>@IndexModel.FormatPrice(sellers.SoldAmountCents)</td></tr>
                        <tr><td>Vendeurs ayant vendu au moins un article</td><td>@sellers.SellersWithSalesCount</td></tr>
                        <tr><td>Articles manquants payés aux vendeurs (@sellers.MissingItemCount)</td><td>@IndexModel.FormatPrice(sellers.MissingItemAmountCents)</td></tr>
                    </tbody>
                </table>
                </div>
                <p class="seller-meta">Prix vendeur des articles vendus, au prix de la vente, avant la commission et les frais d'inscription.</p>
            </section>

            <section class="subsection">
                <h2>Articles</h2>
                <div class="data-list-scroll">
                <table class="data-table statistics-table">
                    <tbody>
                        <tr class="statistics-total-row"><td>Déposés</td><td>@items.TotalCount</td></tr>
                        <tr><td>Vendus</td><td>@items.SoldCount (@IndexModel.FormatPercent(items.SoldCount, items.TotalCount))</td></tr>
                        <tr><td>En stock</td><td>@items.InStockCount</td></tr>
                        <tr><td>Manquants</td><td>@items.MissingCount</td></tr>
                        <tr><td>Défectueux</td><td>@items.DefectiveCount</td></tr>
                        <tr><td>Enregistrés, dépôt non validé</td><td>@items.RegisteredCount</td></tr>
                    </tbody>
                </table>
                </div>
            </section>

            <section class="subsection">
                <h2>Répartition des prix</h2>
                <div class="data-list-scroll">
                <table class="data-table statistics-table">
                    <thead>
                        <tr>
                            <th>Prix</th>
                            <th>Articles déposés</th>
                            <th>Montant déposé</th>
                            <th>Articles vendus</th>
                            <th>Montant vendu</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var bracket in statistics.PriceBrackets)
                    {
                        <tr>
                            <td>@bracket.Label</td>
                            <td>@bracket.ItemCount</td>
                            <td>@IndexModel.FormatPrice(bracket.ItemAmountCents)</td>
                            <td>@bracket.SoldCount</td>
                            <td>@IndexModel.FormatPrice(bracket.SoldAmountCents)</td>
                        </tr>
                    }
                    </tbody>
                </table>
                </div>
            </section>

            <section class="subsection">
                <h2>Villes des acheteurs</h2>
                @if (statistics.Cities.Count == 0)
                {
                    <p class="empty-state">Aucune vente enregistr&eacute;e.</p>
                }
                else
                {
                    <div class="data-list-scroll">
                    <table class="data-table statistics-table">
                        <thead>
                            <tr>
                                <th>Ville</th>
                                <th>Ventes</th>
                                <th>Part</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var city in statistics.Cities)
                        {
                            <tr>
                                <td>@city.City</td>
                                <td>@city.SaleCount</td>
                                <td>@IndexModel.FormatPercent(city.SaleCount, clients.SaleCount)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    </div>
                    <p class="seller-meta">Compté par vente : un même acheteur venu plusieurs fois compte plusieurs fois.</p>
                }
            </section>
        }
    }
</section>

@inject Microsoft.Extensions.Options.IOptions<AssociationSaleTool.Web.Configuration.EventOptions> EventOptions
@inject AssociationSaleTool.Web.Services.SalePhaseService SalePhaseService
@{
    var requestPath = Context.Request.Path;
    var sellersActive = requestPath.StartsWithSegments("/vendeurs")
        || requestPath.StartsWithSegments("/articles");
    var checkoutActive = requestPath.StartsWithSegments("/caisse");
    var dataActive = requestPath.StartsWithSegments("/donnees");
    var reconciliationActive = requestPath.StartsWithSegments("/rapprochement");
    var adminActive = requestPath.StartsWithSegments("/administration");
    var salePhase = await SalePhaseService.GetCurrentPhaseAsync();
    var salePhaseLabel = AssociationSaleTool.Web.Infrastructure.SalePhaseDisplay.ToFrenchLabel(salePhase);
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @EventOptions.Value.Name - @salePhaseLabel</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="page-frame"></div>
    <header class="app-status-header">
        <div class="app-status-display" aria-label="Statut actuel de la vente">
            <span class="app-status-name">@EventOptions.Value.Name</span>
            <span class="app-status-phase">@salePhaseLabel</span>
        </div>
    </header>
    <nav class="main-navigation" aria-label="Navigation principale">
        <a class="main-navigation-link @(sellersActive ? "main-navigation-link-active" : null)"
           href="/vendeurs"
           aria-current="@(sellersActive ? "page" : null)">VENDEURS</a>
        <a class="main-navigation-link @(checkoutActive ? "main-navigation-link-active" : null)"
           href="/caisse"
           aria-current="@(checkoutActive ? "page" : null)">CAISSE</a>
        <a class="main-navigation-link @(dataActive ? "main-navigation-link-active" : null)"
           href="/donnees"
           aria-current="@(dataActive ? "page" : null)">DONNÉES</a>
        <a class="main-navigation-link @(reconciliationActive ? "main-navigation-link-active" : null)"
           href="/rapprochement"
           aria-current="@(reconciliationActive ? "page" : null)">RAPPROCHEMENT</a>
        <a class="main-navigation-link @(adminActive ? "main-navigation-link-active" : null)"
           href="/administration"
           aria-current="@(adminActive ? "page" : null)">ADMIN</a>
    </nav>
    <main class="page-shell">
        @RenderBody()
    </main>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

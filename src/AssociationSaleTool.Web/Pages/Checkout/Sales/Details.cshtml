@page "/caisse/ventes/{id:long}"
@model AssociationSaleTool.Web.Pages.Checkout.Sales.DetailsModel
@{
    ViewData["Title"] = $"Vente #{Model.Sale.SaleId}";
}

<section class="page-card checkout-page sales-view-page">
    <div class="page-header">
        <div>
            <p class="eyebrow">Vente</p>
            <h1 class="page-title">Vente #@Model.Sale.SaleId</h1>
            <p class="seller-meta">Enregistrée le @DetailsModel.FormatSoldAt(Model.Sale.SoldAt).</p>
        </div>
        <div class="header-actions">
            <a class="button-link" href="/caisse/ventes">Retour à la liste</a>
            <a class="button-link button-link-solid" href="/caisse">NOUVELLE VENTE</a>
        </div>
    </div>

    @if (Model.Sale.HasBuyerDetails)
    {
        <section class="subsection">
            <h2>Acheteur</h2>
            <p>@Model.Sale.BuyerDisplay</p>
        </section>
    }

    <section class="subsection">
        <h2>Paiement</h2>
        <dl class="checkout-totals sales-view-totals">
            <div>
                <dt>Mode</dt>
                <dd>@Model.Sale.PaymentMethodLabel</dd>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Sale.ChequeNumber))
            {
                <div>
                    <dt>Numéro de chèque</dt>
                    <dd>@Model.Sale.ChequeNumber</dd>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Sale.ChequeBankName))
            {
                <div>
                    <dt>Banque</dt>
                    <dd>@Model.Sale.ChequeBankName</dd>
                </div>
            }
        </dl>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.Sale.BuyerAddress))
    {
        <section class="subsection">
            <h2>Adresse</h2>
            <p>@Model.Sale.BuyerAddress</p>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Sale.InvoiceNumber))
    {
        <section class="subsection">
            <h2>Facture</h2>
            <dl class="checkout-totals sales-view-totals">
                <div>
                    <dt>Numéro</dt>
                    <dd>@Model.Sale.InvoiceNumber</dd>
                </div>
                @if (Model.Sale.InvoiceIssuedAt is { } invoiceIssuedAt)
                {
                    <div>
                        <dt>Date d'émission</dt>
                        <dd>@DetailsModel.FormatSoldAt(invoiceIssuedAt)</dd>
                    </div>
                }
            </dl>
        </section>
    }

    <section class="subsection">
        <h2>Articles</h2>
        <table class="data-table sales-view-table">
            <thead>
                <tr>
                    <th>REF</th>
                    <th>Titre</th>
                    <th>Prix</th>
                    <th>Statut</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var line in Model.Sale.Lines)
            {
                <tr class="@(line.IsCorrected || line.IsRefunded ? "sales-view-corrected-row" : null)">
                    <td>@line.Reference</td>
                    <td>@line.Title</td>
                    <td>@DetailsModel.FormatPrice(line.SellerPriceAtSaleCents)</td>
                    <td>
                        @if (line.CorrectedAt is { } correctedAt)
                        {
                            <span class="sales-view-status sales-view-status-corrected">
                                Corrigée le @DetailsModel.FormatCorrectedAt(correctedAt)
                            </span>
                        }
                        else if (line.RefundedAt is { } refundedAt)
                        {
                            <span class="sales-view-status sales-view-status-corrected sales-view-status-refunded">
                                <span>@line.RefundStatusLabel</span>
                                <span class="sales-view-status-date">le @DetailsModel.FormatCorrectedAt(refundedAt)</span>
                            </span>
                        }
                        else
                        {
                            <span class="sales-view-status">Vente active</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </section>

    <section class="subsection">
        <h2>Totaux</h2>
        <dl class="checkout-totals sales-view-totals">
            <div>
                <dt>Sous-total</dt>
                <dd>@DetailsModel.FormatPrice(Model.Sale.SubtotalSellerPriceCents)</dd>
            </div>
            <div>
                <dt>Frais association familiale</dt>
                <dd>@DetailsModel.FormatPrice(Model.Sale.CheckoutFeeCents)</dd>
            </div>
            <div class="@(Model.Sale.HasRefunds ? null : "checkout-total-row")">
                <dt>Total</dt>
                <dd>@DetailsModel.FormatPrice(Model.Sale.TotalPaidCents)</dd>
            </div>
            @if (Model.Sale.HasRefunds)
            {
                <div>
                    <dt>Remboursements</dt>
                    <dd>-@DetailsModel.FormatPrice(Model.Sale.RefundTotalCents)</dd>
                </div>
                <div class="checkout-total-row">
                    <dt>Total corrigé</dt>
                    <dd>@DetailsModel.FormatPrice(Model.Sale.CorrectedTotalPaidCents)</dd>
                </div>
            }
        </dl>
    </section>
</section>

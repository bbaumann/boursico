@page "/caisse"
@model AssociationSaleTool.Web.Pages.Checkout.IndexModel
@{
    ViewData["Title"] = "Caisse";
}

<section class="page-card checkout-page" data-checkout-root>
    <div class="page-header">
        <div>
            <p class="eyebrow">Vente</p>
            <h1 class="page-title">Caisse</h1>
            <p class="seller-meta">Recherche locale dans les articles en stock.</p>
        </div>
        <div class="header-actions">
            <a class="button-link button-link-solid" href="/caisse/ventes">LISTE DES VENTES</a>
        </div>
    </div>

    @if (!Model.SaleAllowed)
    {
        <p class="validation" role="status">
            La vente est en @Model.SalePhaseLabel.ToLowerInvariant(). Le passage en caisse est fermé.
        </p>
    }

    <script type="application/json" id="checkout-catalog-data">
        @Html.Raw(Model.CatalogJson)
    </script>

    @if (Model.SaleAllowed)
    {
    <section class="subsection cash-register-setup" data-checkout-cash-register-setup>
        <h2>Caisse</h2>
        <label for="checkout-cash-register-select">
            Caisse
            <select id="checkout-cash-register-select"
                    data-checkout-cash-register-select>
                <option value="">Choisir une caisse</option>
                @foreach (var cashRegister in Model.CashRegisters)
                {
                    <option value="@cashRegister.Id">@cashRegister.Name</option>
                }
            </select>
        </label>
        <div class="form-actions">
            <button type="button" class="button-link button-link-solid" data-checkout-cash-register-save>
                Utiliser cette caisse
            </button>
        </div>
        <p class="validation" data-checkout-cash-register-message role="status" aria-live="polite"></p>
    </section>

    <div data-checkout-workflow hidden>
    <ol class="checkout-step-list" aria-label="Étapes de vente">
        <li><span>Étape 1</span>Acheteur</li>
        <li><span>Étape 2</span>Articles</li>
        <li><span>Étape 3</span>Paiement</li>
    </ol>

    <div class="checkout-grid">
        <section class="subsection checkout-lookup checkout-step-panel" aria-labelledby="checkout-step-buyer-title">
            <section class="checkout-buyer-fields" aria-labelledby="checkout-step-buyer-title">
                <h2 id="checkout-step-buyer-title"><span class="checkout-step-number">Étape 1</span> Acheteur</h2>
                <div class="field-grid" data-postal-city-root>
                    <label for="checkout-buyer-name">
                        <span class="field-label-text">Nom ou structure <span class="required-field-badge">Obligatoire</span></span>
                        <input id="checkout-buyer-name"
                               type="text"
                               autocomplete="name"
                               maxlength="200"
                               required
                               data-checkout-buyer-name />
                    </label>
                    <label for="checkout-buyer-postal-code">
                        <span class="field-label-text">Code postal <span class="required-field-badge">Obligatoire</span></span>
                        <input id="checkout-buyer-postal-code"
                               type="text"
                               inputmode="numeric"
                               maxlength="5"
                               autocomplete="postal-code"
                               required
                               data-postal-code-input
                               data-checkout-buyer-postal-code />
                    </label>
                    <label for="checkout-buyer-city">
                        <span class="field-label-text">Ville <span class="required-field-badge">Obligatoire</span></span>
                        <input id="checkout-buyer-city"
                               type="text"
                               autocomplete="address-level2"
                               maxlength="200"
                               required
                               data-city-input
                               data-checkout-buyer-city />
                        <select id="checkout-buyer-city-select" data-city-select data-checkout-buyer-city-select hidden disabled></select>
                    </label>
                </div>
                <p class="seller-meta">Pour l'Isère, les villes connues sont proposées. Hors Isère, saisissez la ville librement.</p>
                <p class="validation" data-checkout-buyer-message role="status" aria-live="polite"></p>
                <label class="invoice-address-field" for="checkout-buyer-address">
                    Adresse
                    <textarea id="checkout-buyer-address"
                              rows="3"
                              data-checkout-buyer-address
                              placeholder="Adresse client à imprimer sur la facture"></textarea>
                    <span class="seller-meta">À remplir uniquement si le client demande une facture.</span>
                </label>
            </section>

        </section>

        <aside class="subsection checkout-cart-panel checkout-step-panel" aria-labelledby="checkout-step-items-title">
            <h2 id="checkout-step-items-title"><span class="checkout-step-number">Étape 2</span> Articles</h2>

            <label for="checkout-search">Rechercher un article</label>
            <input id="checkout-search"
                   type="search"
                   autocomplete="off"
                   data-checkout-search
                   placeholder="Référence ou description" />

            <div class="checkout-results-frame" data-checkout-results-frame hidden>
                <table class="data-table checkout-results-table">
                    <colgroup>
                        <col class="checkout-reference-column" />
                        <col class="checkout-title-column" />
                        <col class="checkout-price-column" />
                        <col class="checkout-result-action-column" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>REF</th>
                            <th>Description</th>
                            <th>Prix</th>
                            <th>Ajouter</th>
                        </tr>
                    </thead>
                    <tbody data-checkout-results>
                        <tr>
                            <td colspan="4" class="empty-state">Saisissez une recherche pour filtrer les articles.</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <p class="validation" data-checkout-message role="status" aria-live="polite"></p>
            <p class="empty-state" data-checkout-empty-cart>Le panier est vide.</p>

            <table class="data-table checkout-cart-table">
                <colgroup>
                    <col class="checkout-reference-column" />
                    <col class="checkout-title-column" />
                    <col class="checkout-price-column" />
                    <col class="checkout-cart-action-column" />
                </colgroup>
                <thead>
                    <tr>
                        <th>REF</th>
                        <th>Description</th>
                        <th>Prix</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody data-checkout-cart>
                </tbody>
            </table>

            <dl class="checkout-totals">
                <div>
                    <dt>Sous-total</dt>
                    <dd data-checkout-subtotal>0.00 €</dd>
                </div>
                <div>
                    <dt>Frais association familiale</dt>
                    <dd data-checkout-fee>0.00 €</dd>
                </div>
                <div class="checkout-total-row">
                    <dt>Total</dt>
                    <dd data-checkout-total>0.00 €</dd>
                </div>
            </dl>

            <div class="checkout-sticky-summary" data-checkout-sticky-summary>
                <div>
                    <span data-checkout-sticky-count>0 article</span>
                    <strong>Total <span data-checkout-sticky-total>0.00 €</span></strong>
                </div>
                <button type="button"
                        class="button-link button-link-solid"
                        data-checkout-finalize
                        disabled>
                    Finaliser
                </button>
            </div>
        </aside>
    </div>

    <div class="checkout-modal" data-checkout-modal hidden role="dialog" aria-modal="true" aria-labelledby="checkout-modal-title">
        <div class="checkout-modal-panel">
            <h2 id="checkout-modal-title"><span class="checkout-step-number">Étape 3</span> Paiement</h2>
            <p class="seller-meta">Vérifiez le total, choisissez le paiement, puis validez la vente.</p>
            <dl class="checkout-totals">
                <div>
                    <dt>Articles</dt>
                    <dd data-checkout-modal-count>0</dd>
                </div>
                <div>
                    <dt>Sous-total</dt>
                    <dd data-checkout-modal-subtotal>0.00 €</dd>
                </div>
                <div>
                    <dt>Frais association familiale</dt>
                    <dd data-checkout-modal-fee>0.00 €</dd>
                </div>
                <div class="checkout-total-row">
                    <dt>Total</dt>
                    <dd data-checkout-modal-total>0.00 €</dd>
                </div>
            </dl>
            <fieldset class="checkout-payment">
                <legend>Mode de paiement</legend>
                <div class="checkout-payment-options">
                    <label>
                        <input type="radio"
                               name="checkout-payment-method"
                               value="card"
                               data-checkout-payment-method
                               checked />
                        CB
                    </label>
                    <label>
                        <input type="radio"
                               name="checkout-payment-method"
                               value="cash"
                               data-checkout-payment-method />
                        Espèces
                    </label>
                    <label>
                        <input type="radio"
                               name="checkout-payment-method"
                               value="cheque"
                               data-checkout-payment-method />
                        Chèque
                    </label>
                </div>
                <div class="checkout-cheque-details" data-checkout-cheque-details hidden>
                    <label for="checkout-cheque-number">
                        Numéro de chèque
                        <input id="checkout-cheque-number"
                               type="text"
                               autocomplete="off"
                               data-checkout-cheque-number />
                    </label>
                    <label for="checkout-cheque-bank-name">
                        Nom de la banque
                        <input id="checkout-cheque-bank-name"
                               type="text"
                               autocomplete="off"
                               list="checkout-cheque-bank-options"
                               placeholder="Tapez le nom de la banque"
                               data-checkout-cheque-bank-name />
                        <datalist id="checkout-cheque-bank-options">
                            <option value="Crédit Agricole"></option>
                            <option value="La Banque Postale"></option>
                            <option value="Caisse d'Épargne"></option>
                            <option value="Société Générale"></option>
                            <option value="Banque Populaire"></option>
                            <option value="Crédit Mutuel"></option>
                            <option value="BNP Paribas"></option>
                            <option value="LCL"></option>
                            <option value="CIC"></option>
                            <option value="CCF"></option>
                            <option value="Axa Banque"></option>
                            <option value="Crédit Coopératif"></option>
                            <option value="Crédit Maritime"></option>
                            <option value="Banque Palatine"></option>
                            <option value="Banque BCP"></option>
                        </datalist>
                    </label>
                </div>
                <p class="validation checkout-payment-message"
                   data-checkout-payment-message
                   role="status"
                   aria-live="polite"></p>
            </fieldset>
            <div class="form-actions checkout-modal-actions">
                <button type="button" class="button-link" data-checkout-modal-back>Retour</button>
                <button type="button" class="button-link button-link-solid" data-checkout-save-sale>Valider sans imprimer</button>
                <button type="button"
                        class="button-link button-link-solid"
                        data-checkout-save-print
                        disabled>
                    Valider et imprimer la facture
                </button>
            </div>
        </div>
    </div>
    </div>
    }
</section>

@if (Model.SaleAllowed)
{
<section class="checkout-print-invoice" data-checkout-invoice aria-hidden="true">
    <header class="checkout-invoice-header">
        <img class="checkout-invoice-logo" src="@Model.Printing.LogoPath" alt="Logo Association Familiale" />
        <div>
            <h1>Facture <span data-checkout-invoice-number></span></h1>
            <p>Date d'émission : <span data-checkout-invoice-issued-at></span></p>
        </div>
    </header>

    <section class="checkout-invoice-parties">
        <div class="checkout-invoice-party">
            <h2>Vendeur</h2>
            <p>@Model.Printing.SellerName</p>
            <p>@Model.Printing.SellerAddress</p>
            <p>SIRET : @Model.Printing.SellerSiret</p>
            <p>@Model.Printing.SellerLegalStatus</p>
        </div>
        <div class="checkout-invoice-party" data-checkout-invoice-customer-section hidden>
            <h2>Client</h2>
            <p class="checkout-invoice-customer-text" data-checkout-invoice-customer-text></p>
        </div>
    </section>

    <table class="data-table checkout-invoice-table">
        <colgroup>
            <col class="checkout-invoice-quantity-column" />
            <col class="checkout-invoice-designation-column" />
            <col class="checkout-invoice-amount-column" />
            <col class="checkout-invoice-amount-column" />
        </colgroup>
        <thead>
            <tr>
                <th>Quantité</th>
                <th>Désignation</th>
                <th>P.U. HT</th>
                <th>Total HT</th>
            </tr>
        </thead>
        <tbody data-checkout-invoice-lines>
        </tbody>
    </table>

    <dl class="checkout-totals">
        <div>
            <dt>Sous-total articles HT</dt>
            <dd data-checkout-invoice-subtotal>0.00 €</dd>
        </div>
        <div>
            <dt>Frais association familiale HT</dt>
            <dd data-checkout-invoice-fee>0.00 €</dd>
        </div>
        <div class="checkout-total-row">
            <dt>Total HT</dt>
            <dd data-checkout-invoice-total-excluding-vat>0.00 €</dd>
        </div>
        <div>
            <dt>TVA</dt>
            <dd data-checkout-invoice-vat>0.00 €</dd>
        </div>
        <div class="checkout-total-row">
            <dt>Total TTC</dt>
            <dd data-checkout-invoice-total-including-vat>0.00 €</dd>
        </div>
    </dl>
    <p class="checkout-invoice-vat-exemption" data-checkout-invoice-vat-exemption>
        @Model.Printing.VatExemptionText
    </p>
</section>
}

@page "/caisse"
@model AssociationSaleTool.Web.Pages.Checkout.IndexModel
@{
    ViewData["Title"] = "Caisse";
}

<section class="page-card checkout-page" data-checkout-root>
    <div class="page-header">
        <div>
            <p class="eyebrow">Vente</p>
            <h1 class="page-title">Caisse</h1>
            <p class="seller-meta">Recherche locale dans les articles en stock.</p>
        </div>
        <div class="header-actions">
            <a class="button-link button-link-solid" href="/caisse/ventes">LISTE DES VENTES</a>
        </div>
    </div>

    @if (!Model.SaleAllowed)
    {
        <p class="validation" role="status">
            La vente est en @Model.SalePhaseLabel.ToLowerInvariant(). Le passage en caisse est fermé.
        </p>
    }

    <script type="application/json" id="checkout-catalog-data">
        @Html.Raw(Model.CatalogJson)
    </script>

    @if (Model.SaleAllowed)
    {
    <div class="checkout-grid">
        <section class="subsection checkout-lookup">
            <section class="checkout-buyer-fields" aria-labelledby="checkout-buyer-title">
                <h2 id="checkout-buyer-title">Acheteur</h2>
                <div class="field-grid">
                    <label for="checkout-buyer-name">
                        Nom ou structure
                        <input id="checkout-buyer-name"
                               type="text"
                               autocomplete="name"
                               maxlength="200"
                               data-checkout-buyer-name />
                    </label>
                    <label for="checkout-buyer-postal-code">
                        Code postal
                        <input id="checkout-buyer-postal-code"
                               type="number"
                               inputmode="numeric"
                               min="0"
                               max="99999"
                               step="1"
                               autocomplete="postal-code"
                               data-checkout-buyer-postal-code />
                    </label>
                    <label for="checkout-buyer-city">
                        Ville
                        <input id="checkout-buyer-city"
                               type="text"
                               autocomplete="address-level2"
                               maxlength="200"
                               list="checkout-buyer-city-options"
                               data-checkout-buyer-city />
                        <datalist id="checkout-buyer-city-options" data-checkout-buyer-city-options></datalist>
                    </label>
                </div>
                <p class="seller-meta">Pour l'Isère, les villes connues sont proposées. Hors Isère, saisissez la ville librement.</p>
            </section>

        </section>

        <aside class="subsection checkout-cart-panel">
            <h2>Panier</h2>

            <label for="checkout-search">Rechercher un article</label>
            <input id="checkout-search"
                   type="search"
                   autocomplete="off"
                   data-checkout-search
                   placeholder="Référence ou titre" />

            <div class="checkout-results-frame">
                <table class="data-table checkout-results-table">
                    <colgroup>
                        <col class="checkout-reference-column" />
                        <col class="checkout-title-column" />
                        <col class="checkout-price-column" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>REF</th>
                            <th>Titre</th>
                            <th>Prix</th>
                        </tr>
                    </thead>
                    <tbody data-checkout-results>
                        <tr>
                            <td colspan="3" class="empty-state">Saisissez une recherche pour filtrer les articles.</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <p class="validation" data-checkout-message role="status" aria-live="polite"></p>
            <p class="empty-state" data-checkout-empty-cart>Le panier est vide.</p>

            <table class="data-table checkout-cart-table">
                <colgroup>
                    <col class="checkout-reference-column" />
                    <col class="checkout-title-column" />
                    <col class="checkout-price-column" />
                    <col class="checkout-cart-action-column" />
                </colgroup>
                <thead>
                    <tr>
                        <th>REF</th>
                        <th>Titre</th>
                        <th>Prix</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody data-checkout-cart>
                </tbody>
            </table>

            <dl class="checkout-totals">
                <div>
                    <dt>Sous-total</dt>
                    <dd data-checkout-subtotal>0.00 EUR</dd>
                </div>
                <div>
                    <dt>Frais association familiale</dt>
                    <dd data-checkout-fee>0.00 EUR</dd>
                </div>
                <div class="checkout-total-row">
                    <dt>Total</dt>
                    <dd data-checkout-total>0.00 EUR</dd>
                </div>
            </dl>

            <label class="receipt-details-field" for="checkout-receipt-details">
                Détails du reçu
                <textarea id="checkout-receipt-details"
                          rows="3"
                          data-checkout-receipt-details
                          placeholder="Nom, organisation ou adresse"></textarea>
                <span class="seller-meta">À remplir uniquement si le client demande un reçu.</span>
            </label>

            <div class="form-actions checkout-finalize-actions">
                <button type="button"
                        class="button-link button-link-solid"
                        data-checkout-finalize
                        disabled>
                    Finaliser
                </button>
            </div>
        </aside>
    </div>

    <div class="checkout-modal" data-checkout-modal hidden role="dialog" aria-modal="true" aria-labelledby="checkout-modal-title">
        <div class="checkout-modal-panel">
            <h2 id="checkout-modal-title">Finaliser la vente</h2>
            <dl class="checkout-totals">
                <div>
                    <dt>Articles</dt>
                    <dd data-checkout-modal-count>0</dd>
                </div>
                <div>
                    <dt>Sous-total</dt>
                    <dd data-checkout-modal-subtotal>0.00 EUR</dd>
                </div>
                <div>
                    <dt>Frais association familiale</dt>
                    <dd data-checkout-modal-fee>0.00 EUR</dd>
                </div>
                <div class="checkout-total-row">
                    <dt>Total</dt>
                    <dd data-checkout-modal-total>0.00 EUR</dd>
                </div>
            </dl>
            <fieldset class="checkout-payment">
                <legend>Mode de paiement</legend>
                <div class="checkout-payment-options">
                    <label>
                        <input type="radio"
                               name="checkout-payment-method"
                               value="card"
                               data-checkout-payment-method
                               checked />
                        CB
                    </label>
                    <label>
                        <input type="radio"
                               name="checkout-payment-method"
                               value="cash"
                               data-checkout-payment-method />
                        Espèces
                    </label>
                    <label>
                        <input type="radio"
                               name="checkout-payment-method"
                               value="cheque"
                               data-checkout-payment-method />
                        Chèque
                    </label>
                </div>
                <div class="checkout-cheque-details" data-checkout-cheque-details hidden>
                    <label for="checkout-cheque-number">
                        Numéro de chèque
                        <input id="checkout-cheque-number"
                               type="text"
                               autocomplete="off"
                               data-checkout-cheque-number />
                    </label>
                    <label for="checkout-cheque-bank-name">
                        Nom de la banque
                        <input id="checkout-cheque-bank-name"
                               type="text"
                               autocomplete="off"
                               data-checkout-cheque-bank-name />
                    </label>
                </div>
                <p class="validation checkout-payment-message"
                   data-checkout-payment-message
                   role="status"
                   aria-live="polite"></p>
            </fieldset>
            <div class="form-actions checkout-modal-actions">
                <button type="button" class="button-link" data-checkout-modal-back>Retour</button>
                <button type="button" class="button-link button-link-solid" data-checkout-save-sale>Enregistrer la vente</button>
                <button type="button"
                        class="button-link button-link-solid"
                        data-checkout-save-print
                        disabled>
                    Enregistrer et imprimer
                </button>
            </div>
        </div>
    </div>
    }
</section>

@if (Model.SaleAllowed)
{
<section class="checkout-print-receipt" data-checkout-receipt aria-hidden="true">
    <header>
        <h1 data-checkout-receipt-header>@Model.ReceiptHeaderText</h1>
        <p>Reçu de vente <span data-checkout-receipt-sale-id></span></p>
        <p>Date : <span data-checkout-receipt-date></span></p>
    </header>

    <section data-checkout-receipt-buyer-section hidden>
        <h2>Acheteur</h2>
        <p data-checkout-receipt-buyer-text></p>
    </section>

    <section>
        <h2>Détails du reçu</h2>
        <p data-checkout-receipt-details-text></p>
    </section>

    <table class="data-table">
        <thead>
            <tr>
                <th>REF</th>
                <th>Titre</th>
                <th>Prix</th>
            </tr>
        </thead>
        <tbody data-checkout-receipt-lines>
        </tbody>
    </table>

    <dl class="checkout-totals">
        <div>
            <dt>Sous-total</dt>
            <dd data-checkout-receipt-subtotal>0.00 EUR</dd>
        </div>
        <div>
            <dt>Frais association familiale</dt>
            <dd data-checkout-receipt-fee>0.00 EUR</dd>
        </div>
        <div class="checkout-total-row">
            <dt>Total</dt>
            <dd data-checkout-receipt-total>0.00 EUR</dd>
        </div>
    </dl>
</section>
}

@page
@model IndexModel
@{
    ViewData["Title"] = "Association Sale Tool";
}

<section class="hero">
    <p class="eyebrow">Foundation Ready</p>
    <h1>Association Sale Tool</h1>
    <p class="lead">Centralized event operations and reconciliation for the annual toy sale.</p>

    <dl class="status-grid">
        <div>
            <dt>Runtime</dt>
            <dd>.NET 8 Razor Pages</dd>
        </div>
        <div>
            <dt>Database</dt>
            <dd>SQLite with one file per event</dd>
        </div>
        <div>
            <dt>Current Slice</dt>
            <dd>Foundation, domain rules, and schema</dd>
        </div>
    </dl>
</section>

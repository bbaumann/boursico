@page "/"
@model IndexModel
@{
    ViewData["Title"] = "Outil de vente de l'association";
}

<section class="hero">
    <p class="eyebrow">Base prête</p>
    <h1>Outil de vente de l'association</h1>
    <p class="lead">Gestion centralisée des opérations de vente et du rapprochement pour la vente annuelle de jouets.</p>

    <dl class="status-grid">
        <div>
            <dt>Socle</dt>
            <dd>.NET 8 Razor Pages</dd>
        </div>
        <div>
            <dt>Base de données</dt>
            <dd>SQLite avec un fichier par événement</dd>
        </div>
        <div>
            <dt>Étape actuelle</dt>
            <dd>Fondations, règles métier et schéma</dd>
        </div>
    </dl>
</section>

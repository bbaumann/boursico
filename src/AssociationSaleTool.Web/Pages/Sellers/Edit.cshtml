@page "/vendeurs/{id:long}/modifier"
@model AssociationSaleTool.Web.Pages.Sellers.EditModel
@{
    ViewData["Title"] = "Modifier le vendeur";
}

<section class="page-card form-card">
    <p class="eyebrow">Saisie</p>
    <h1 class="page-title">Modifier le vendeur</h1>

    @if (!Model.CanEditSellerMasterData)
    {
        <p class="validation">Les informations du vendeur ne peuvent pas être modifiées dans le statut actuel de la vente.</p>
    }

    <form method="post" class="stack-form">
        <div asp-validation-summary="ModelOnly" class="validation"></div>
        @if (Model.DuplicateMatches.Count > 0)
        {
            <section class="duplicate-match-list" aria-label="Vendeurs existants">
                <h2>Vendeurs existants</h2>
                <ul>
                @foreach (var match in Model.DuplicateMatches)
                {
                    <li>
                        <strong>@match.SellerCode - @match.FirstName @match.LastName</strong>
                        <span>@(string.IsNullOrWhiteSpace(match.Phone) ? "Téléphone à compléter" : match.Phone)</span>
                        <span>@(match.Email ?? "Sans e-mail")</span>
                        <span>@match.ItemCount article@(match.ItemCount > 1 ? "s" : "")</span>
                        <a class="button-link" asp-page="/Sellers/Details" asp-route-id="@match.SellerId">Ouvrir ce vendeur</a>
                    </li>
                }
                </ul>
            </section>
        }

        <div class="field-grid">
            <label>
                <span class="field-label-text">Prénom <span class="required-field-badge">Obligatoire</span></span>
                <input asp-for="Input.FirstName" aria-required="true" disabled="@(!Model.CanEditSellerMasterData)" />
                <span asp-validation-for="Input.FirstName" class="validation"></span>
            </label>
            <label>
                <span class="field-label-text">Nom <span class="required-field-badge">Obligatoire</span></span>
                <input asp-for="Input.LastName" aria-required="true" disabled="@(!Model.CanEditSellerMasterData)" />
                <span asp-validation-for="Input.LastName" class="validation"></span>
            </label>
            <label>
                <span>E-mail</span>
                <input asp-for="Input.Email" disabled="@(!Model.CanEditSellerMasterData)" />
                <span asp-validation-for="Input.Email" class="validation"></span>
            </label>
            <label>
                <span class="field-label-text">Téléphone <span class="required-field-badge">Obligatoire</span></span>
                <input asp-for="Input.Phone" type="tel" inputmode="numeric" pattern="[0-9]*" title="Chiffres uniquement" aria-required="true" disabled="@(!Model.CanEditSellerMasterData)" />
                <span asp-validation-for="Input.Phone" class="validation"></span>
            </label>
            <label>
                <span>Frais payés (€ entier)</span>
                <input asp-for="Input.FeePaid"
                       type="text"
                       inputmode="numeric"
                       pattern="[0-9]+"
                       data-whole-euro-input="true"
                       data-whole-euro-message="Les frais payés doivent être un montant entier en euros."
                       disabled="@(!Model.CanEditSellerMasterData)" />
                <span asp-validation-for="Input.FeePaid" class="validation"></span>
            </label>
        </div>

        <label>
            <span class="field-label-text">Adresse postale <span class="required-field-badge">Obligatoire</span></span>
            <textarea asp-for="Input.PostalAddress" rows="2" aria-required="true" disabled="@(!Model.CanEditSellerMasterData)"></textarea>
            <span asp-validation-for="Input.PostalAddress" class="validation"></span>
        </label>

        <div class="field-grid" data-postal-city-root>
            <label>
                <span class="field-label-text">Code postal <span class="required-field-badge">Obligatoire</span></span>
                <input asp-for="Input.PostalCode"
                       type="text"
                       inputmode="numeric"
                       maxlength="5"
                       autocomplete="postal-code"
                       data-postal-code-input
                       aria-required="true"
                       disabled="@(!Model.CanEditSellerMasterData)" />
                <span asp-validation-for="Input.PostalCode" class="validation"></span>
            </label>
            <label>
                <span class="field-label-text">Ville <span class="required-field-badge">Obligatoire</span></span>
                <input asp-for="Input.City"
                       type="text"
                       maxlength="200"
                       autocomplete="address-level2"
                       data-city-input
                       aria-required="true"
                       disabled="@(!Model.CanEditSellerMasterData)" />
                <select name="Input.City" data-city-select hidden disabled></select>
                <span asp-validation-for="Input.City" class="validation"></span>
            </label>
        </div>
        <p class="seller-meta">Pour l'Isère, choisissez une ville connue. Hors Isère, saisissez la ville librement.</p>

        <div class="field-grid">
            <label>
                <span>Nature de la pièce d'identité</span>
                <input asp-for="Input.IdentityDocumentType" autocomplete="off" list="identity-document-type-options" placeholder="Choisissez ou tapez la nature" disabled="@(!Model.CanEditSellerMasterData)" />
                <datalist id="identity-document-type-options">
                    <option value="Carte d'identité"></option>
                    <option value="Passeport"></option>
                    <option value="Permis de conduire"></option>
                    <option value="Titre de séjour"></option>
                </datalist>
                <span asp-validation-for="Input.IdentityDocumentType" class="validation"></span>
            </label>
            <label>
                <span>Numéro de la pièce d'identité</span>
                <input asp-for="Input.IdentityDocumentNumber" disabled="@(!Model.CanEditSellerMasterData)" />
                <span asp-validation-for="Input.IdentityDocumentNumber" class="validation"></span>
            </label>
            <label>
                <span>Date de délivrance</span>
                <input asp-for="Input.IdentityDocumentIssuedOn"
                       type="date"
                       disabled="@(!Model.CanEditSellerMasterData)" />
                <span asp-validation-for="Input.IdentityDocumentIssuedOn" class="validation"></span>
            </label>
        </div>

        <label>
            <span>Notes</span>
            <textarea asp-for="Input.Notes" rows="3" disabled="@(!Model.CanEditSellerMasterData)"></textarea>
        </label>

        <label>
            <span>Notes d'import</span>
            <textarea asp-for="Input.ImportNotes" rows="4" disabled="@(!Model.CanEditSellerMasterData)"></textarea>
        </label>

        <div class="form-actions">
            @if (Model.CanEditSellerMasterData)
            {
                <button type="submit" class="button-link button-link-solid">Enregistrer</button>
            }
            <a class="button-link" asp-page="/Sellers/Details" asp-route-id="@Model.SellerId">Annuler</a>
        </div>
    </form>
</section>

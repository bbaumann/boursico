@page "/vendeurs"
@model AssociationSaleTool.Web.Pages.Sellers.IndexModel
@{
    ViewData["Title"] = "Vendeurs";
}

<section class="page-card">
    <div class="page-header">
        <div>
            <p class="eyebrow">Saisie</p>
            <h1 class="page-title">Vendeurs</h1>
        </div>
        <a class="button-link" asp-page="/Sellers/Create">Créer un vendeur</a>
    </div>

    @if (Model.Sellers.Count == 0)
    {
        <p class="empty-state">Aucun vendeur pour le moment.</p>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Nom</th>
                    <th>E-mail</th>
                    <th>Articles</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var seller in Model.Sellers)
            {
                <tr>
                    <td>@seller.SellerCode</td>
                    <td>@seller.FirstName @seller.LastName</td>
                    <td>@(seller.Email ?? "—")</td>
                    <td>@seller.Items.Count</td>
                    <td><a asp-page="/Sellers/Details" asp-route-id="@seller.Id">Ouvrir</a></td>
                </tr>
            }
            </tbody>
        </table>
    }
</section>

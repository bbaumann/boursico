@page
@model AssociationSaleTool.Web.Pages.Sellers.IndexModel
@{
    ViewData["Title"] = "Sellers";
}

<section class="page-card">
    <div class="page-header">
        <div>
            <p class="eyebrow">Intake</p>
            <h1 class="page-title">Sellers</h1>
        </div>
        <a class="button-link" asp-page="/Sellers/Create">Create Seller</a>
    </div>

    @if (Model.Sellers.Count == 0)
    {
        <p class="empty-state">No sellers yet.</p>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Items</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var seller in Model.Sellers)
            {
                <tr>
                    <td>@seller.SellerCode</td>
                    <td>@seller.FirstName @seller.LastName</td>
                    <td>@(seller.Email ?? "—")</td>
                    <td>@seller.Items.Count</td>
                    <td><a asp-page="/Sellers/Details" asp-route-id="@seller.Id">Open</a></td>
                </tr>
            }
            </tbody>
        </table>
    }
</section>

@page "/vendeurs"
@model AssociationSaleTool.Web.Pages.Sellers.IndexModel
@{
    ViewData["Title"] = "Vendeurs";
}

<section class="page-card" data-seller-search-root>
    <div class="page-header">
        <div>
            <p class="eyebrow">Saisie</p>
            <h1 class="page-title">Vendeurs</h1>
        </div>
        @if (Model.CanEditSellerMasterData)
        {
            <div class="header-actions">
                <a class="button-link" asp-page="/Sellers/Import">Importer des soumissions</a>
                <a class="button-link" asp-page="/Sellers/Create">Créer un vendeur</a>
            </div>
        }
    </div>

    @if (!Model.CanEditSellerMasterData)
    {
        <p class="validation">Les informations des vendeurs sont en lecture seule dans le statut actuel de la vente.</p>
    }

    @if (Model.Sellers.Count == 0)
    {
        <p class="empty-state">Aucun vendeur pour le moment.</p>
    }
    else
    {
        <section class="subsection">
            <label for="seller-search">Filtrer les vendeurs</label>
            <input id="seller-search"
                   type="search"
                   autocomplete="off"
                   data-seller-search
                   placeholder="Nom" />
            <p class="empty-state" data-seller-empty-message hidden>Aucun vendeur ne correspond à cette recherche.</p>
        </section>

        <table class="data-table seller-index-table">
            <colgroup>
                <col class="seller-index-name-column" />
                <col class="seller-index-email-column seller-index-secondary-column" />
                <col class="seller-index-items-column" />
                <col class="seller-index-action-column" />
            </colgroup>
            <thead>
                <tr>
                    <th>Nom</th>
                    <th class="seller-index-secondary-column">E-mail</th>
                    <th>Articles</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var seller in Model.Sellers)
            {
                <tr data-seller-row data-seller-filter-text="@IndexModel.BuildSellerFilterText(seller)">
                    <td>@seller.FirstName @seller.LastName</td>
                    <td class="seller-index-secondary-column">@(seller.Email ?? "—")</td>
                    <td>@seller.Items.Count</td>
                    <td><a asp-page="/Sellers/Details" asp-route-id="@seller.Id">Ouvrir</a></td>
                </tr>
            }
            </tbody>
        </table>
    }
</section>

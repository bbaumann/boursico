@page "/vendeurs/{id:long}"
@using AssociationSaleTool.Web.Domain.Items
@model AssociationSaleTool.Web.Pages.Sellers.DetailsModel
@{
    ViewData["Title"] = "Détail du vendeur";
    var depositValidationCount = Model.DepositValidationMessages.Count;
    var depositSummary = Model.IsDepositValidated
        ? "Le dépôt est validé. Les articles sont en stock et le dépôt reste annulable par un administrateur."
        : depositValidationCount > 0
            ? $"{depositValidationCount} information{(depositValidationCount > 1 ? "s" : string.Empty)} à corriger avant de finaliser le dépôt."
            : "Le dépôt est prêt dès que le contrat papier est imprimé et signé.";
}

@if (!string.IsNullOrWhiteSpace(Model.PendingRowsAlert))
{
    <aside class="existing-seller-alert" data-existing-seller-alert role="status" aria-live="polite">
        <p class="existing-seller-alert-title">Vendeur déjà existant</p>
        <p>@Model.PendingRowsAlert</p>
    </aside>
}

<section class="page-card seller-detail-card">
    <div class="page-header">
        <div>
            <p class="eyebrow">Saisie</p>
            <h1 class="page-title">@Model.Seller!.FirstName @Model.Seller.LastName</h1>
            <p class="seller-meta">@Model.Seller.SellerCode</p>
        </div>
        <div class="header-actions">
            @if (Model.CanEditSellerMasterData)
            {
                <a class="button-link" asp-page="/Sellers/Edit" asp-route-id="@Model.Seller.Id">Modifier</a>
            }
            <a class="button-link" asp-page="/Sellers/Index">Retour aux vendeurs</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.DepositSuccessMessage))
    {
        <p class="success-message seller-deposit-success" data-seller-deposit-success role="status">
            @Model.DepositSuccessMessage
        </p>
    }

    <section class="subsection seller-deposit-panel">
        <div>
            <h2>Dépôt vendeur</h2>
            <p class="seller-deposit-status @(Model.IsDepositValidated ? "seller-deposit-status-validated" : "seller-deposit-status-pending")">
                @Model.DepositStatusLabel
            </p>
            <p class="seller-deposit-summary">@depositSummary</p>
        </div>
        @if (Model.DepositValidationMessages.Count > 0)
        {
            <div class="validation" role="alert">
                <p>Corrigez les points ci-dessous avant de finaliser le dépôt.</p>
                <div class="seller-deposit-blocker-summary">
                    @if (Model.HasSellerDepositValidationMessages)
                    {
                        <div>
                            <strong>Fiche vendeur</strong>
                            <span>Des informations obligatoires manquent.</span>
                        </div>
                    }
                    @if (Model.HasItemDepositValidationMessages)
                    {
                        <div>
                            <strong>Articles</strong>
                            <span>Des articles sont incomplets ou absents.</span>
                        </div>
                    }
                </div>
                <ul class="seller-deposit-blocker-detail">
                    @foreach (var message in Model.DepositValidationMessages)
                    {
                        <li>@message</li>
                    }
                </ul>
                <div class="form-actions seller-deposit-validation-actions">
                    @if (Model.HasSellerDepositValidationMessages && Model.CanEditSellerMasterData)
                    {
                        <a class="button-link button-link-solid" asp-page="/Sellers/Edit" asp-route-id="@Model.Seller.Id">Corriger la fiche vendeur</a>
                    }
                    @if (Model.HasItemDepositValidationMessages && Model.CanEditItemMasterData)
                    {
                        <a class="button-link" href="#articles">Corriger les articles incomplets</a>
                    }
                </div>
            </div>
        }
        <div class="form-actions seller-deposit-actions">
            @if (Model.CanValidateDeposit)
            {
                <div class="seller-deposit-flow"
                     data-seller-deposit-flow
                     data-seller-deposit-initial-step="@Model.DepositFinalizationInitialStep"
                     @Html.Raw(Model.ShouldOpenDepositFinalizationDialog ? "data-seller-deposit-auto-open" : string.Empty)>
                    <form method="post"
                          asp-page-handler="BeginDepositFinalization"
                          asp-route-id="@Model.Seller.Id"
                          class="inline-form">
                        <button type="submit" class="button-link button-link-solid" data-seller-deposit-begin>
                            Finaliser le dépôt
                        </button>
                    </form>
                    <dialog id="deposit-finalization-dialog"
                            class="admin-dialog seller-deposit-dialog"
                            data-seller-deposit-dialog
                            aria-labelledby="deposit-finalization-title">
                        <h3 id="deposit-finalization-title">Finaliser le dépôt</h3>
                        <ol class="seller-deposit-step-list">
                            <li data-seller-deposit-step-indicator="fees" aria-current="step">Frais</li>
                            <li data-seller-deposit-step-indicator="print">Contrat</li>
                            <li data-seller-deposit-step-indicator="validate">Signature</li>
                        </ol>
                        <section class="seller-deposit-step-panel" data-seller-deposit-fee-step>
                            <h4>Frais</h4>
                            <div class="seller-deposit-fee-recap">
                                <p>Attendus : @DetailsModel.FormatPrice(Model.FeeStatus.ExpectedFeeCents)</p>
                                <p>Payés : @DetailsModel.FormatPrice(Model.FeeStatus.PaidFeeCents)</p>
                                <p>
                                    Reste : @DetailsModel.FormatPrice(Model.FeeStatus.RemainingFeeCents)
                                    @if (!Model.FeeStatus.IsFullyPaid)
                                    {
                                        <span>Déduit au rapprochement</span>
                                    }
                                </p>
                            </div>
                            <form method="post"
                                  asp-page-handler="UpdateDepositFee"
                                  asp-route-id="@Model.Seller.Id"
                                  class="stack-form">
                                <label>
                                    <span>Frais payés (€ entier)</span>
                                    <input asp-for="DepositFeeInput.FeePaid"
                                           type="text"
                                           inputmode="numeric"
                                           pattern="[0-9]+"
                                           data-whole-euro-input="true"
                                           data-whole-euro-message="Les frais payés doivent être un montant entier en euros." />
                                    <span asp-validation-for="DepositFeeInput.FeePaid" class="validation"></span>
                                </label>
                                <div class="form-actions">
                                    <button type="button" class="button-link" data-seller-deposit-close>Retour</button>
                                    <button type="submit" class="button-link button-link-solid">Continuer</button>
                                </div>
                            </form>
                        </section>
                        <section class="seller-deposit-step-panel" data-seller-deposit-print-step hidden>
                            <h4>Contrat</h4>
                            <div class="form-actions">
                                <button type="button" class="button-link" data-seller-deposit-back-to-fees>Retour</button>
                                <button type="button"
                                        class="button-link button-link-solid"
                                        data-seller-deposit-print
                                        data-seller-deposit-print-url="@Url.Page("/Sellers/DepositContract", new { id = Model.Seller.Id, impression = "auto" })">
                                    Imprimer le contrat
                                </button>
                            </div>
                        </section>
                        <section class="seller-deposit-step-panel" data-seller-deposit-validate-step hidden>
                            <h4>Signature</h4>
                            <form method="post"
                                  asp-page-handler="ValidateDeposit"
                                  asp-route-id="@Model.Seller.Id"
                                  class="stack-form">
                                <label class="checkbox-label">
                                    <input type="checkbox" data-seller-deposit-signature-confirmation />
                                    <span>Le contrat papier est signé par le vendeur.</span>
                                </label>
                                <div class="form-actions">
                                    <button type="button" class="button-link" data-seller-deposit-back>Retour</button>
                                    <button type="submit" class="button-link button-link-solid" data-seller-deposit-submit disabled>
                                        Valider le dépôt
                                    </button>
                                </div>
                            </form>
                        </section>
                    </dialog>
                </div>
            }
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.ReadOnlyMessage))
    {
        <p class="validation">@Model.ReadOnlyMessage</p>
    }

    <dl class="seller-contact-list">
        <div>
            <dt>E-mail</dt>
            <dd>@(Model.Seller.Email ?? "Sans e-mail")</dd>
        </div>
        <div>
            <dt>Téléphone</dt>
            <dd>@Model.Seller.Phone</dd>
        </div>
        <div>
            <dt>Adresse</dt>
            <dd>
                @Model.Seller.PostalAddress
                @if (!string.IsNullOrWhiteSpace(Model.Seller.PostalCode) || !string.IsNullOrWhiteSpace(Model.Seller.City))
                {
                    <br />
                    <span>@Model.Seller.PostalCode @Model.Seller.City</span>
                }
            </dd>
        </div>
        <div>
            <dt>Nature de la pièce d'identité</dt>
            <dd>@(Model.Seller.IdentityDocumentType ?? "À compléter")</dd>
        </div>
        <div>
            <dt>Numéro de la pièce d'identité</dt>
            <dd>@(Model.Seller.IdentityDocumentNumber ?? "À compléter")</dd>
        </div>
        <div>
            <dt>Date de délivrance</dt>
            <dd>@DetailsModel.FormatDate(Model.Seller.IdentityDocumentIssuedOn)</dd>
        </div>
    </dl>

    <p class="seller-fee-status @(Model.FeeStatus.IsFullyPaid ? "seller-fee-status-paid" : "seller-fee-status-due")">
        Frais : @DetailsModel.FormatPrice(Model.FeeStatus.ExpectedFeeCents) (payés @DetailsModel.FormatPrice(Model.FeeStatus.PaidFeeCents))
    </p>

    @if (!string.IsNullOrWhiteSpace(Model.Seller.ImportNotes))
    {
        <section class="subsection existing-seller-alert">
            <h2>Import à vérifier</h2>
            <pre>@Model.Seller.ImportNotes</pre>
        </section>
    }

    <section class="subsection" id="articles">
        <h2>Articles</h2>
        @if (Model.Items.Count == 0)
        {
            <p class="empty-state">Aucun article pour ce vendeur.</p>
        }
        else
        {
            <table class="data-table seller-items-table">
                <colgroup>
                    <col class="seller-items-reference-column" />
                    <col class="seller-items-title-column" />
                    <col class="seller-items-price-column" />
                    <col class="seller-items-status-column" />
                    <col class="seller-items-action-column" />
                </colgroup>
                <thead>
                    <tr>
                        <th>Référence</th>
                        <th>Titre</th>
                        <th>Prix vendeur</th>
                        <th>Statut</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@(string.IsNullOrEmpty(item.Reference) ? "—" : item.Reference)</td>
                        <td>@item.Title</td>
                        <td>@DetailsModel.FormatPrice(item.SellerPriceCents)</td>
                        <td>@AssociationSaleTool.Web.Infrastructure.ItemStatusDisplay.ToFrenchLabel(item.Status)</td>
                        <td>
                            <div class="table-actions">
                                @if (Model.CanEditItemMasterData && item.Status is "registered" or "in_stock")
                                {
                                    <a asp-page="/Items/Edit" asp-route-id="@item.Id">Modifier</a>
                                }
                                @if (Model.CanEditItemMasterData && ItemDeletionPolicy.CanDelete(item.Status))
                                {
                                    <form method="post"
                                          class="inline-form"
                                          asp-page-handler="DeleteItem"
                                          asp-route-id="@Model.Seller.Id"
                                          asp-route-itemId="@item.Id"
                                          onsubmit="return confirm('Voulez-vous vraiment supprimer cet article ?');">
                                        <button type="submit" class="table-action-button">Supprimer</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>

    @if (Model.CanCancelDepositValidation)
    {
        <section class="subsection seller-deposit-admin-section">
            <h2>Administration</h2>
            <p class="seller-meta">Action réservée aux administrateurs pour corriger une validation de dépôt faite par erreur.</p>
            <button type="button"
                    class="button-link"
                    onclick="document.getElementById('deposit-cancellation-dialog')?.showModal();">
                Annuler la validation du dépôt
            </button>
            <dialog id="deposit-cancellation-dialog" class="admin-dialog">
                <h3>Annulation de la validation du dépôt</h3>
                <p>Les articles encore en stock repasseront en enregistrés. Les articles déjà vendus, manquants ou défectueux resteront verrouillés.</p>
                <form method="post"
                      asp-page-handler="CancelDepositValidation"
                      asp-route-id="@Model.Seller.Id"
                      class="stack-form">
                    <label>
                        <span>Mot de passe administrateur</span>
                        <input asp-for="CancellationInput.AdminPassword" type="password" autocomplete="current-password" />
                        <span asp-validation-for="CancellationInput.AdminPassword" class="validation"></span>
                    </label>
                    <div class="form-actions">
                        <button type="submit" class="button-link button-link-solid">Annuler la validation</button>
                        <button type="button"
                                class="button-link"
                                onclick="document.getElementById('deposit-cancellation-dialog')?.close();">
                            Retour
                        </button>
                    </div>
                </form>
            </dialog>
        </section>
    }

    @if (Model.CanEditItemMasterData)
    {
    <section class="subsection">
        <h2>Ajouter des articles</h2>

        @* The explicit action is load-bearing: without it the browser posts this form to
           the current URL, query string included. The deposit dialog handlers return
           Page() rather than redirecting, so after opening the dialog the address bar
           still carries ?handler=..., and adding items would re-enter that handler
           instead of creating them. *@
        <form method="post"
              asp-page="/Sellers/Details"
              asp-route-id="@Model.Seller.Id"
              class="stack-form">
            <div asp-validation-summary="All" class="validation"></div>

            <table class="data-table intake-table seller-intake-table" data-item-registration-table>
                <colgroup>
                    <col class="seller-intake-title-column" />
                    <col class="seller-intake-price-column" />
                </colgroup>
                <thead>
                    <tr>
                        <th>Titre</th>
                        <th>Prix vendeur (€ entier)</th>
                    </tr>
                </thead>
                <tbody>
                @for (var i = 0; i < Model.Input.Rows.Count; i++)
                {
                    <tr>
                        <td>
                            <input asp-for="Input.Rows[i].Title" />
                            <span asp-validation-for="Input.Rows[i].Title" class="validation"></span>
                        </td>
                        <td>
                            <input asp-for="Input.Rows[i].SellerPrice"
                                   type="text"
                                   inputmode="numeric"
                                   pattern="[0-9]+"
                                   data-whole-euro-input="true"
                                   data-whole-euro-message="Le prix vendeur doit être un montant entier en euros." />
                            <span asp-validation-for="Input.Rows[i].SellerPrice" class="validation"></span>
                        </td>
                    </tr>
                }
                </tbody>
            </table>

            <div class="item-registration-actions">
                <button type="button" class="add-row-button" data-add-item-row aria-label="Ajouter une ligne" title="Ajouter une ligne">+</button>
            </div>

            <div class="form-actions">
                <button type="submit" class="button-link button-link-solid">Enregistrer le lot</button>
            </div>
        </form>
    </section>
    }
</section>
